# Application
APP_ENV=local
APP_NAME=AI Security Engineer
LOG_LEVEL=INFO

# Database: local Docker Compose defaults only; do not use production credentials here.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_security_engineer

# PostgreSQL container settings for local development only
POSTGRES_DB=ai_security_engineer
POSTGRES_USER=app
POSTGRES_PASSWORD=app
